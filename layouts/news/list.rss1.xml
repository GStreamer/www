{{- /* RSS 1.0 (RDF) feed, same structure as src/htdocs/news/news2rss-1.0.xsl. Plain-text template: nothing is auto-escaped. */ -}}
{{- $site := "" -}}
{{- $pages := .Pages.ByDate.Reverse -}}
<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns="http://purl.org/rss/1.0/">
  <channel rdf:about="http://www.gstreamer.net/news/">
    <title>GStreamer News</title>
    <link>{{ $site }}/news/</link>
    <description>Latest news from the GStreamer project</description>
    <items>
      <rdf:Seq>
        <rdf:li rdf:resource="..."/>
{{- range $pages }}
        <rdf:li rdf:resource="{{ $site }}/news/#{{ partial "news-anchor.html" . }}"/>
{{- end }}
      </rdf:Seq>
    </items>
  </channel>
{{- range $pages }}
  <item rdf:about="{{ $site }}/news/#{{ partial "news-anchor.html" . }}">
    <title>{{ .Title | htmlEscape }}</title>
    <link>{{ $site }}/news/#{{ partial "news-anchor.html" . }}</link>
    <dc:date>{{ partial "news-anchor.html" . }}</dc:date>
    <content:encoded><![CDATA[{{ .Content }}]]></content:encoded>
  </item>
{{- end }}
</rdf:RDF>
