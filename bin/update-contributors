#!/usr/bin/env python3
# -*- Mode: Python -*-
# vi:si:et:sw=4:sts=4:ts=4

"""
Extract contributors since the previous release from a ChangeLog
and write them into the "Contributors to X.Y.Z" section of the release
notes page (content/releases/X.Y/_index.md)
"""

# FIXME: automatically update the release.xml file

import sys
import os
import re
import codecs

def main():
    if len(sys.argv) < 4:
        sys.stderr.write("Usage: update-contributors ChangeLog content/releases/X.Y/_index.md VERSION\n")
        sys.exit(1)
    changelog = sys.argv[1]
    release = sys.argv[2]
    version = sys.argv[3]
    if not os.path.exists(changelog):
        sys.stderr.write("%s does not exist.\n" % changelog)
        sys.exit(1)

    names = []

    lines = codecs.open(changelog, "r", encoding='utf-8', errors='replace').readlines()
    relmatcher = re.compile('^=== release .* ===$')
    if relmatcher.match(lines[0]):
        del lines[0]

    datedmatcher = re.compile(r'^\d*-\d*-\d*\s(?:[0-9:]+ [+-]\d{4}\s)\s?(.*)\s*<.*>$')
    bymatcher = re.compile(r' by: ([^<]+)\s*.*$')
    byaddyonlymatcher = re.compile(r' by:[ ]*<([^>]*)')
    for line in lines:
        if relmatcher.match(line):
            break
        for matcher in [datedmatcher, bymatcher, byaddyonlymatcher]:
            match = matcher.search(line)
            if match:
                name = match.expand("\\1").rstrip()
                if name == "":
                  print("Warning: parsed null name from '%s'" % (line))
                if not name in names and name != "":
                    names.append(name)
    names.sort()

    # wrap the comma separated names like the existing release notes
    wrapped, cur = [], ""
    for n in names:
        piece = n + ","
        if cur and len(cur) + 1 + len(piece) > 78:
            wrapped.append(cur)
            cur = piece
        else:
            cur = (cur + " " + piece) if cur else piece
    if cur:
        wrapped.append(cur)
    contr = "\n".join(wrapped)

    doc = codecs.open(release, "r", encoding='utf-8').read()
    header = "#### Contributors to %s\n\n" % version
    start = doc.find(header)
    if start < 0:
        sys.stderr.write("No '%s' section in %s\n" % (header.strip(), release))
        sys.exit(1)
    start += len(header)
    end = doc.find("\n... and many others", start)
    if end < 0:
        sys.stderr.write("No '... and many others' line after the contributors in %s\n" % release)
        sys.exit(1)

    target = release + ".bak"
    os.rename(release, target)
    handle = codecs.open(release, "w", encoding='utf-8')
    handle.write(doc[:start] + contr + "\n" + doc[end:])
    handle.close()
    os.remove(target)

main()
