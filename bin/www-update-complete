#!/bin/sh
# this script is run on the fdo server, so no use running at home
# it deploys the site built by the latest "website" CI job on the main branch, the planet
# and the activity numbers, see ci/www_cron.py (also run from cron)

umask 0002
exec /srv/gstreamer.freedesktop.org/www/ci/www_cron.py
